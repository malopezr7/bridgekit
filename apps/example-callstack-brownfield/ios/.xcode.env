# .xcode.env — resolve NODE_BINARY for the RN bundler script phases.
# This file is committed. For local overrides use .xcode.env.local (gitignored).
#
# The brownfield "Bundle React Native code and images" script phase sources
# this file via with-environment.sh before invoking react-native-xcode.sh.
# Mirrors apps/example/ios/.xcode.env pattern (inferred from RN 0.83 scaffold).

export NODE_BINARY=$(command -v node)
