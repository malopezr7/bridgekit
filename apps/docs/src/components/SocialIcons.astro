---
// GitHub as a highlighted button (jato-style) while keeping the GitHub logo.
// Falls back to nothing if no github social link is configured.
import config from 'virtual:starlight/user-config';

const social = config.social || [];
const github = social.find((s) => s.icon === 'github');
const rest = social.filter((s) => s.icon !== 'github');
---

{
	github && (
		<a class="gh-button" href={github.href} target="_blank" rel="me noopener noreferrer">
			<svg
				class="gh-logo"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="currentColor"
				aria-hidden="true"
			>
				<path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.63 8.21 11.19.6.11.82-.25.82-.56 0-.28-.01-1.02-.02-2-3.34.71-4.04-1.58-4.04-1.58-.55-1.37-1.34-1.74-1.34-1.74-1.09-.73.08-.72.08-.72 1.2.08 1.84 1.21 1.84 1.21 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.57-2.67-.3-5.47-1.31-5.47-5.83 0-1.29.47-2.34 1.24-3.17-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.21a11.6 11.6 0 0 1 3-.39c1.02 0 2.05.13 3 .39 2.28-1.53 3.29-1.21 3.29-1.21.65 1.66.24 2.88.12 3.18.77.83 1.23 1.88 1.23 3.17 0 4.53-2.81 5.53-5.49 5.82.43.36.81 1.08.81 2.18 0 1.57-.01 2.84-.01 3.23 0 .31.21.68.83.56C20.56 21.91 24 17.5 24 12.29 24 5.78 18.63.5 12 .5Z" />
			</svg>
			<span>GitHub</span>
		</a>
	)
}
{
	rest.map((s) => (
		<a class="gh-plain" href={s.href} target="_blank" rel="me noopener noreferrer">
			<span class="sr-only">{s.label}</span>
		</a>
	))
}

<style>
	.gh-button {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		line-height: 1;
		padding: 0.45rem 0.8rem;
		border-radius: 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
	}
	.gh-button:hover {
		background: var(--sl-color-white);
		color: var(--sl-color-bg);
		border-color: var(--sl-color-white);
		transform: translateY(-1px);
	}
	.gh-logo {
		flex-shrink: 0;
	}
</style>
