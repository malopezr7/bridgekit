{
  "name": "@malopezr7/bridgekit",
  "version": "0.1.0-alpha.1",
  "description": "Typed bidirectional bridge between React Native and native (Android/iOS)",
  "author": "malopezr7 <malopezr7@gmail.com> (https://github.com/malopezr7)",
  "license": "MIT",
  "homepage": "https://github.com/malopezr7/bridgekit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malopezr7/bridgekit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/malopezr7/bridgekit/issues"
  },
  "keywords": [
    "react-native",
    "android",
    "ios",
    "nitro",
    "nitro-modules",
    "bridge",
    "native-modules",
    "ipc",
    "typescript",
    "codegen"
  ],
  "main": "dist/commonjs/index.js",
  "module": "dist/module/index.js",
  "types": "dist/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/module/index.js",
      "require": "./dist/commonjs/index.js"
    },
    "./contract": {
      "types": "./dist/typescript/contract/index.d.ts",
      "react-native": "./src/contract/index.ts",
      "import": "./dist/module/contract/index.js",
      "require": "./dist/commonjs/contract/index.js"
    },
    "./react": {
      "types": "./dist/typescript/react/index.d.ts",
      "react-native": "./src/react/index.ts",
      "import": "./dist/module/react/index.js",
      "require": "./dist/commonjs/react/index.js"
    },
    "./test": {
      "types": "./dist/typescript/testing/index.d.ts",
      "react-native": "./src/testing/index.ts",
      "import": "./dist/module/testing/index.js",
      "require": "./dist/commonjs/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "android/src",
    "!android/src/test",
    "android/build.gradle.kts",
    "android/CMakeLists.txt",
    "android/fix-prefab.gradle",
    "android/consumer-rules.pro",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.swift",
    "ios-facade",
    "nitrogen/generated",
    "react-native.config.js",
    "nitro.json",
    "*.podspec",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__tests__/**",
    "!**/__typechecks__",
    "!**/__typechecks__/**",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "build": "bob build && node scripts/fix-esm-relative-imports.mjs && node scripts/verify-esm-exports.mjs",
    "prepack": "pnpm build",
    "clean": "rimraf android/build && rimraf dist",
    "clean:modules": "rimraf .turbo node_modules",
    "check": "biome check src/",
    "format": "biome check --write src/",
    "typecheck": "tsc --noEmit",
    "nitrogen": "nitrogen && node scripts/patch-nitrogen-namespaces.js",
    "test": "pnpm test:web && pnpm test:native",
    "test:native": "jest --config ./jest.config.cjs --selectProjects native",
    "test:web": "jest --config ./jest.config.cjs --selectProjects web",
    "pub:beta": "pnpm publish --no-git-checks --access public --tag beta",
    "pub:next": "pnpm publish --no-git-checks --access public --tag next",
    "pub:release": "pnpm publish --access public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^19",
    "react-native": ">=0.83",
    "react-native-nitro-modules": "^0.35.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      "commonjs",
      [
        "module",
        {
          "configFile": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ],
    "exclude": "{**/tests/**,**/__tests__/**,**/__typechecks__/**,**/*.stories.*}"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@babel/preset-env": "7.28.3",
    "@babel/runtime": "7.28.3",
    "@biomejs/biome": "2.5.2",
    "@react-native/babel-preset": "0.83.6",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nitrogen": "0.35.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-builder-bob": "0.41.0",
    "react-native-nitro-modules": "0.35.0",
    "rimraf": "6.0.1",
    "typescript": "5.9.2"
  }
}
