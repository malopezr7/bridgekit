{
  "name": "@malopezr7/bridgekit",
  "description": "Typed bidirectional bridge between React Native and native (Android/iOS)",
  "version": "83.0.0",
  "author": "malopezr7 <malopezr7@gmail.com> (https://github.com/malopezr7)",
  "bugs": "https://github.com/malopezr7/bridgekit/issues",
  "engines": {
    "node": ">=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/typescript/index.d.ts",
      "import": "./src/index.ts",
      "require": "./dist/commonjs/index.js"
    },
    "./contract": {
      "types": "./dist/typescript/contract/index.d.ts",
      "import": "./src/contract/index.ts",
      "require": "./dist/commonjs/contract/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "android",
    "ios",
    "src",
    "README.md",
    "nitro.json",
    "nitrogen/generated",
    "android/CMakeLists.txt",
    "android/build.gradle.kts",
    "android/fix-prefab.gradle",
    "*.podspec",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!android/build"
  ],
  "homepage": "https://github.com/malopezr7/bridgekit#readme",
  "keywords": [
    "android",
    "ios",
    "react-native"
  ],
  "license": "MIT",
  "main": "dist/commonjs/index.js",
  "module": "src/index.ts",
  "peerDependencies": {
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-nitro-modules": "0.35.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "react-native": "src/index.ts",
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      "commonjs",
      [
        "module",
        {
          "configFile": true
        }
      ],
      "typescript"
    ],
    "exclude": "{**/tests/**,**/*.stories.*}"
  },
  "repository": "git+https://github.com/malopezr7/bridgekit.git",
  "scripts": {
    "build": "bob build",
    "check": "biome check src/",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf android/build && rimraf dist",
    "clean:modules": "rimraf .turbo node_modules",
    "format": "biome check --write src/",
    "prepublish": "bob build",
    "pub:beta": "pnpm publish --no-git-checks --access public --tag beta",
    "pub:next": "pnpm publish --no-git-checks --access public --tag next",
    "pub:release": "pnpm publish --access public",
    "test": "pnpm test:web && pnpm test:native",
    "nitrogen": "nitrogen && node scripts/patch-nitrogen-namespaces.js",
    "test:native": "jest --config ./jest.config.cjs --selectProjects native --passWithNoTests",
    "test:web": "jest --config ./jest.config.cjs --selectProjects web --passWithNoTests"
  },
  "sideEffects": false,
  "source": "src/index.ts",
  "types": "dist/typescript/index.d.ts",
  "devDependencies": {
    "@babel/core": "7.28.3",
    "@babel/preset-env": "7.28.3",
    "@babel/runtime": "7.28.3",
    "@react-native/babel-preset": "0.83.6",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "jest": "29.7.0",
    "nitrogen": "0.35.0",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-builder-bob": "0.41.0",
    "react-native-nitro-modules": "0.35.0",
    "rimraf": "6.0.1",
    "typescript": "5.9.2"
  }
}
