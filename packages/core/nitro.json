{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["BridgeKit"],
  "ios": {
    "iosModuleName": "BridgeKit"
  },
  "android": {
    "androidNamespace": ["bridgekit"],
    "androidCxxLibName": "BridgeKit"
  },
  "autolinking": {
    "BridgeHost": {
      "swift": "HybridBridgeHost",
      "kotlin": "HybridBridgeHost"
    },
    "BridgeStreams": {
      "swift": "HybridBridgeStreams",
      "kotlin": "HybridBridgeStreams"
    },
    "BridgeState": {
      "swift": "HybridBridgeState",
      "kotlin": "HybridBridgeState"
    }
  },
  "ignorePaths": ["**/node_modules"]
}
