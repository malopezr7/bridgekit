{
  "compilerOptions": {
    "outDir": "dist",
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noImplicitUseStrict": false,
    "noStrictGenericChecks": false,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "jest.*"
  ],
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
