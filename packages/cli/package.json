{
  "name": "@malopezr7/bridgekit-cli",
  "version": "0.0.1-beta.0",
  "description": "Code-generation CLI for BridgeKit — emits Kotlin & Swift bindings from TypeScript contracts",
  "author": "malopezr7 <malopezr7@gmail.com> (https://github.com/malopezr7)",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/malopezr7/bridgekit/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malopezr7/bridgekit.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/malopezr7/bridgekit/issues"
  },
  "keywords": [
    "react-native",
    "bridgekit",
    "codegen",
    "kotlin",
    "swift",
    "cli"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "bridgekit": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "check": "biome check src/",
    "prepack": "tsc",
    "test": "jest --config ./jest.config.cjs",
    "test:codec": "jest --config ./jest.config.cjs --testPathPattern=codec --passWithNoTests",
    "test:hash": "jest --config ./jest.config.cjs --testPathPattern=hash",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@malopezr7/bridgekit": "workspace:*",
    "chalk": "4.1.2"
  },
  "devDependencies": {
    "@babel/core": "7.28.3",
    "@biomejs/biome": "2.5.2",
    "@react-native/babel-preset": "0.83.6",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.0.0",
    "babel-jest": "29.7.0",
    "jest": "29.7.0",
    "typescript": "5.9.2"
  }
}
